APP_ENV=development
APP_NAME="Gestión Comercial"
APP_URL=http://localhost:8080

DB_HOST=db
DB_PORT=3306
DB_NAME=gestion_comercial
DB_USER=gcom_user
# Obligatorias: docker compose no arranca si faltan. Genera valores propios:
#   php -r "echo bin2hex(random_bytes(24));"
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_CHARSET=utf8mb4

# Genera uno propio, p. ej.:
#   php -r "echo bin2hex(random_bytes(48));"
JWT_SECRET=cambia_esto_por_una_clave_segura_minimo_32_caracteres
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Rate limiting del login
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_IP_ATTEMPTS=20

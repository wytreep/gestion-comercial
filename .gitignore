.env
!.env.example
backend/vendor/
client/node_modules/
client/dist/
backend/coverage/
backend/.phpunit.cache/
.vscode/
.idea/
.DS_Store
Thumbs.db
docker/db/data/
*.log

# Datos reales de clientes/ventas: nunca versionar.
database/private/
# Red de seguridad: solo el esquema puede entrar al repositorio.
database/migrations/*.sql
!database/migrations/001_schema.sql
!database/migrations/002_cobros_qr.sql
!database/migrations/003_etiquetas.sql
!database/migrations/004_notificaciones_unique.sql
!database/migrations/005_tema_usuario.sql
!database/migrations/006_seguridad.sql

# Artefactos de auditoria visual (Hallmark: capturas y registros)
.hallmark/

# Configuracion local de herramientas; no forma parte del producto
.mcp.json
.markdown-collab/

# Python
__pycache__/
*.pyc

# Generador de entregables Word: perfil de Chrome y celdas intermedias
docs/entregables/word/assets/diagrams/.chrome-profile/
docs/entregables/word/assets/diagrams/*-h[0-9]*.png
docs/entregables/word/assets/diagrams/*-g[0-9]*.png
docs/entregables/word/assets/diagrams/*-p[0-9]*.png
docs/entregables/word/assets/diagrams/*.html
